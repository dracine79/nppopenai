#include <windows.h>
#include "PromptChooserResource.h"
#pragma code_page(65001)

IDD_PROMPT_CHOOSER DIALOGEX 0, 0, 440, 315
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "NppOpenAI - Choisir une instruction"
FONT 9, "Segoe UI"
BEGIN
    LTEXT       "Consignes :", IDC_PROMPT_CONSIGNES_LABEL, 8, 8, 180, 11
    EDITTEXT    IDC_PROMPT_CONSIGNES, 8, 20, 424, 38, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT       "Nom de l'instruction :", IDC_PROMPT_NAME_LABEL, 8, 65, 180, 11
    EDITTEXT    IDC_PROMPT_NAME, 8, 77, 424, 17, ES_AUTOHSCROLL | WS_TABSTOP
    LISTBOX     IDC_PROMPT_SUGGEST, 8, 94, 424, 68, LBS_NOTIFY | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT       "Saisir un nom ou choisir un menu.", IDC_PROMPT_HINT, 8, 98, 424, 11
    LTEXT       "Instructions récentes (1 à 5)", IDC_PROMPT_RECENT_LABEL, 8, 102, 220, 11
    LISTBOX     IDC_PROMPT_RECENTS, 8, 115, 424, 88, LBS_NOTIFY | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    CONTROL     "Conserver la sélection et la consigne (8)", IDC_PROMPT_KEEP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 216, 280, 15
    CONTROL     "Afficher le raisonnement (9)", IDC_PROMPT_REASONING, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 233, 280, 15
    DEFPUSHBUTTON "Valider", IDOK, 314, 288, 55, 18, WS_TABSTOP
    PUSHBUTTON  "Annuler", IDCANCEL, 377, 288, 55, 18, WS_TABSTOP
END
