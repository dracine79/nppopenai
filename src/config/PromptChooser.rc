#include <windows.h>
#include "PromptChooserResource.h"

IDD_PROMPT_CHOOSER DIALOGEX 0, 0, 340, 278
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "NppOpenAI - Choisir une instruction"
FONT 9, "Segoe UI"
BEGIN
    LTEXT       "Filtrer par nom :", -1, 8, 9, 85, 11
    EDITTEXT    IDC_PROMPT_FILTER, 8, 22, 324, 15, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON  "&Tous", IDC_PROMPT_ALL, 8, 43, 56, 16, WS_TABSTOP
    PUSHBUTTON  "&Edition", IDC_PROMPT_EDIT, 75, 43, 56, 16, WS_TABSTOP
    PUSHBUTTON  "T&onalite", IDC_PROMPT_TONE, 142, 43, 56, 16, WS_TABSTOP
    PUSHBUTTON  "&Format", IDC_PROMPT_FORMAT, 209, 43, 56, 16, WS_TABSTOP
    PUSHBUTTON  "&Commandes", IDC_PROMPT_COMMAND, 276, 43, 56, 16, WS_TABSTOP
    LISTBOX     IDC_PROMPT_LIST, 8, 65, 324, 178, LBS_NOTIFY | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    DEFPUSHBUTTON "&Valider", IDOK, 224, 251, 52, 17, WS_TABSTOP
    PUSHBUTTON  "Annuler", IDCANCEL, 280, 251, 52, 17, WS_TABSTOP
END
